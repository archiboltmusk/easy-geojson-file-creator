{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/archiboltmusk/easy-geojson-file-creator/schema/ward.schema.json",
  "title": "CivicShape ward boundaries",
  "description": "A GeoJSON FeatureCollection (RFC 7946) of municipal ward boundaries for one city. Geometry rules the schema cannot express (closed rings, winding order, coordinate bounds) are checked by scripts/validate-data.mjs.",
  "type": "object",
  "required": [
    "type",
    "features"
  ],
  "properties": {
    "type": {
      "const": "FeatureCollection"
    },
    "name": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/wardFeature"
      }
    }
  },
  "not": {
    "required": [
      "crs"
    ]
  },
  "$defs": {
    "wardFeature": {
      "type": "object",
      "required": [
        "type",
        "properties",
        "geometry"
      ],
      "properties": {
        "type": {
          "const": "Feature"
        },
        "id": {
          "description": "Stable id, e.g. IN-WB-PURULIA-W01 (country-state-city-W+ward number).",
          "type": [
            "string",
            "integer"
          ]
        },
        "properties": {
          "$ref": "#/$defs/wardProperties"
        },
        "geometry": {
          "oneOf": [
            {
              "$ref": "#/$defs/polygon"
            },
            {
              "$ref": "#/$defs/multiPolygon"
            }
          ]
        }
      }
    },
    "wardProperties": {
      "type": "object",
      "required": [
        "state",
        "district",
        "municipality_name",
        "municipality_type",
        "ward_number",
        "ward_name",
        "year_delimited",
        "source_url",
        "license"
      ],
      "properties": {
        "state": {
          "description": "State or union territory, full English name.",
          "type": "string",
          "minLength": 1,
          "examples": [
            "Karnataka",
            "Maharashtra"
          ]
        },
        "district": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "Bengaluru Urban"
          ]
        },
        "municipality_name": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "Bruhat Bengaluru Mahanagara Palike"
          ]
        },
        "municipality_type": {
          "type": "string",
          "enum": [
            "municipal_corporation",
            "municipal_council",
            "nagar_panchayat",
            "town_panchayat",
            "cantonment_board",
            "notified_area_committee",
            "industrial_township",
            "other"
          ]
        },
        "ward_number": {
          "description": "Official ward number. Use an integer; use a string only for suffixed numbers such as \"12A\".",
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^[0-9]+[A-Za-z]?$"
            }
          ]
        },
        "ward_name": {
          "description": "Official ward name, or null when the ward has only a number.",
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "year_delimited": {
          "description": "Year of the delimitation notification these boundaries come from, or null when unknown (e.g. traced from an undated map).",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1900,
          "maximum": 2100
        },
        "source_url": {
          "description": "Where the boundaries came from: a notification, portal or dataset page.",
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "license": {
          "description": "License of the source data, as an SPDX identifier where one exists.",
          "type": "string",
          "minLength": 1,
          "examples": [
            "ODbL-1.0",
            "CC-BY-4.0",
            "GODL-India",
            "CC0-1.0"
          ]
        },
        "country": {
          "description": "ISO 3166-1 alpha-2 code. Optional; defaults to IN.",
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "default": "IN"
        }
      }
    },
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "linearRing": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/position"
      }
    },
    "polygon": {
      "type": "object",
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "const": "Polygon"
        },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/linearRing"
          }
        }
      }
    },
    "multiPolygon": {
      "type": "object",
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "const": "MultiPolygon"
        },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/linearRing"
            }
          }
        }
      }
    }
  }
}
